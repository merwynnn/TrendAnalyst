# ---------------------------------------------------------------------------
# Trend Analyst — environment overrides (OPTIONAL). Copy to .env only if you
# want to override a setting without editing YAML. Sample values only — this
# file is committed, so it contains NO real credentials.
#
# Credentials live in config/secrets.local.yaml (untracked). See
# config/secrets.example.yaml for the template and USER_SETUP.md for the
# per-provider walkthrough. Env vars are supported as an *override* layer
# (defaults < config/settings.yaml < config/settings.local.yaml < env < CLI),
# which is what CI uses; locally you never need them.
# ---------------------------------------------------------------------------

# --- optional non-secret overrides -----------------------------------------
# TA_ENV=dev                      # dev | prod  (selects config/settings.<env>.yaml)
# TA_LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
# TA_LOG_JSON=true                # structured logs (default: true outside dev)
# TA_CONFIG_DIR=config            # where settings*.yaml / sources.yaml live
# TA_DRY_RUN=true                 # never write to the outside world

# --- credentials (CI only; prefer the secrets file locally) -----------------
# TA_DATABASE__URL=postgresql+psycopg://user:password@host:5432/trend_analyst
# TA_LLM__GEMINI_API_KEY=
# TA_LLM__GROQ_API_KEY=
# TA_LLM__CEREBRAS_API_KEY=
# TA_LLM__OLLAMA_BASE_URL=http://localhost:11434
# TA_TIER_A__EBAY_CLIENT_ID=
# TA_TIER_A__EBAY_CLIENT_SECRET=
# TA_TIER_A__GITHUB_TOKEN=
# TA_TIER_A__BESTBUY_API_KEY=
# TA_TIER_A__SERPER_API_KEY=
# TA_TIER_A__PRODUCTHUNT_TOKEN=
# TA_TIER_A__WALMART_CLIENT_ID=
# TA_TIER_A__WALMART_CLIENT_SECRET=
# TA_TIER_A__SEARCHAPI_KEY=
